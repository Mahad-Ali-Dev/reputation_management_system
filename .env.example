# ============================================================
# Repulabs — environment variables
# Copy to .env.local for local dev. NEVER commit .env.local.
#
# Production domains:
#   • SaaS app:        https://repulabs.com
#   • Hardware shop:   https://repulabs.com.au
# ============================================================

# ---- Core ----
NODE_ENV=development
# Port the Node process listens on. Nginx upstream points to this.
PORT=3000
# Disable Next.js anonymous telemetry in production.
NEXT_TELEMETRY_DISABLED=1
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Used by QR-image generation (the URL embedded on the QR), email links,
# OAuth callbacks, Stripe redirects, etc. For local dev keep localhost so the
# auth flow works; for production set this to https://repulabs.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_DOMAIN=localhost:3000              # production: repulabs.com
ADMIN_DOMAIN=admin.localhost:3000      # production: admin.repulabs.com
REDIRECT_DOMAIN=r.localhost:3000       # production: r.repulabs.com

# ---- Database (Neon) ----
# Get from https://console.neon.tech — pooled connection string
# Format: postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL=""
# Direct (non-pooled) — for migrations only (use the non-pooler hostname)
DIRECT_URL=""

# ---- Auth.js (NextAuth v5) ----
# Generate via: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL=http://localhost:3000
# CRITICAL when running behind a reverse proxy (Nginx on Hostinger, ALB on AWS).
# Without this, Auth.js v5 ignores X-Forwarded-Host/Proto headers and login
# redirects break in production. Set to "true" on any prod deploy.
AUTH_TRUST_HOST=false

# Google SSO — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (magic-link emails + transactional) — https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Repulabs <auth@repulabs.com>"

# ---- Stripe ----
# Test keys: https://dashboard.stripe.com/test/apikeys
# Live keys: https://dashboard.stripe.com/apikeys (use sk_live_ in production)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# After running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, paste the whsec_ here
STRIPE_WEBHOOK_SECRET=""
# Pro plan price ID (create in Stripe dashboard, $167/mo, 7-day trial)
STRIPE_PRO_PRICE_ID=""
# Hardware product price IDs (one-time)
STRIPE_HARDWARE_STAND_PRICE_ID=""

# ---- Cron ----
# Long random string. Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}` on each invocation.
# Generate via: openssl rand -base64 32
CRON_SECRET=""

# ---- Anthropic ----
# https://console.anthropic.com — separate keys per env
ANTHROPIC_API_KEY="sk-ant-..."
# Per-tenant default daily AI cap in micros ($1.00 = 1_000_000)
AI_TENANT_DAILY_CAP_MICROS=4000000

# ---- Upstash (Redis + QStash) ----
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ---- Twilio (SMS) ----
# https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+15551234567"

# ---- Encryption ----
# 32-byte key for envelope encryption, base64-encoded
# Generate via: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=""
# 32-byte key for short-link slug HMAC signing
SLUG_HMAC_SECRET=""
# 32-byte secret for OAuth state JWT
OAUTH_STATE_SECRET=""

# ---- Cloudflare ----
# Account-level token with KV write permission for r.<domain> namespace
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_KV_NAMESPACE_ID=""
CLOUDFLARE_API_TOKEN=""

# ---- Observability ----
# Sentry — https://sentry.io
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
# Axiom — https://axiom.co
AXIOM_TOKEN=""
AXIOM_DATASET="repuboost"

# ---- Google Business Profile API ----
# https://console.cloud.google.com — same project as Google SSO; enable GBP API
GBP_CLIENT_ID="${AUTH_GOOGLE_ID}"
GBP_CLIENT_SECRET="${AUTH_GOOGLE_SECRET}"

# ---- Voyage embeddings (chatbot RAG, Phase 1+) ----
VOYAGE_API_KEY=""

# ---- Shopify (hardware storefront) ----
# Public URL surfaced as a "Buy stands" link from /hardware and /hardware/new.
# The Shopify store lives on a separate domain from the SaaS app.
# Falls back to https://repulabs.com.au if unset.
NEXT_PUBLIC_SHOPIFY_STORE_URL="https://repulabs.com.au"

# ---- Vercel Blob (or alternative blob storage for org logos) ----
# Required if you use lib/uploads against Vercel Blob. On AWS, swap for S3 (see docs/AWS_DEPLOY.md).
BLOB_READ_WRITE_TOKEN=""

# ---- ElevenLabs (voice cloning for phone receptionist) ----
# Optional — only needed for AI phone receptionist voice features.
ELEVENLABS_API_KEY=""

# ---- Unsubscribe token HMAC (optional) ----
# If set, used to sign email unsubscribe URLs. If unset, AUTH_SECRET is reused
# (see lib/secrets.ts). Set this when you want to rotate unsubscribe signing
# independently of session cookies.
# Generate via: openssl rand -base64 32
UNSUBSCRIBE_SECRET=""

# ---- AWS-specific (only set when deploying to AWS) ----
# See docs/AWS_DEPLOY.md for the full architecture.
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET_UPLOADS="repulabs-uploads-prod"
# AWS_RDS_PROXY_ENDPOINT=""
# DATABASE_URL_READONLY=""  # Aurora reader endpoint, optional

# ---- Hostinger VPS / generic VPS deployment ----
# See docs/DEPLOY_HOSTINGER.md for the full deployment runbook.
# Comma-separated CIDR list of IPs allowed to hit /admin/*. Empty = allow any.
# Example: "203.0.113.42,198.51.100.0/24"
ADMIN_IP_ALLOWLIST=""
# Optional: S3-compatible bucket for nightly backup of .env.local + uploads dir.
BACKUP_S3_BUCKET=""
