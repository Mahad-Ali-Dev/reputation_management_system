# ============================================================
# Repulabs — environment variables
# Copy to .env.local for local dev. NEVER commit .env.local.
#
# Production domains:
#   • SaaS app:        https://repulabs.com
#   • Hardware shop:   https://repulabs.com.au
# ============================================================

# ---- Core ----
NODE_ENV=development
# Port the Node process listens on. Nginx upstream points to this.
PORT=3000
# Disable Next.js anonymous telemetry in production.
NEXT_TELEMETRY_DISABLED=1
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Used by QR-image generation (the URL embedded on the QR), email links,
# OAuth callbacks, Stripe redirects, etc. For local dev keep localhost so the
# auth flow works; for production set this to https://repulabs.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail OAuth — OPTIONAL but strongly recommended before OAuth verification.
# Google verifies per OAuth client, and the tier follows the most privileged
# scope that client asks for:
#   business.manage         -> SENSITIVE  (verification only)
#   gmail.readonly/.send    -> RESTRICTED (verification + paid CASA security audit)
# While Gmail shares AUTH_GOOGLE_ID with the Business Profile connect, the whole
# app is pushed into the restricted tier. Put Gmail on its own OAuth client (its
# own Google Cloud project) and the main client stays on the sensitive track.
# Unset = falls back to AUTH_GOOGLE_ID/SECRET (today's behaviour).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# SEO / Google Search Console
# Public marketing origin used by sitemap.xml + robots.txt. Defaults to
# https://repulabs.com — only set this if the marketing site moves.
NEXT_PUBLIC_MARKETING_URL=https://repulabs.com
# Optional: token from Search Console → "HTML tag" verification. Leave blank
# if verifying by DNS TXT (recommended for a domain property).
GOOGLE_SITE_VERIFICATION=
APP_DOMAIN=localhost:3000              # production: repulabs.com
ADMIN_DOMAIN=admin.localhost:3000      # production: admin.repulabs.com
REDIRECT_DOMAIN=r.localhost:3000       # production: r.repulabs.com

# ---- Database (Neon) ----
# Get from https://console.neon.tech — pooled connection string
# Format: postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL=""
# Direct (non-pooled) — for migrations only (use the non-pooler hostname)
DIRECT_URL=""

# ---- Auth.js (NextAuth v5) ----
# Generate via: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL=http://localhost:3000
# CRITICAL when running behind a reverse proxy (Nginx on Hostinger, ALB on AWS).
# Without this, Auth.js v5 ignores X-Forwarded-Host/Proto headers and login
# redirects break in production. Set to "true" on any prod deploy.
AUTH_TRUST_HOST=false

# Google SSO — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (magic-link emails + transactional) — https://resend.com/api-keys
RESEND_API_KEY=""
# EMAIL_FROM MUST be an address on a domain you have VERIFIED in the Resend
# dashboard (Domains → Add Domain → publish the SPF/DKIM/DMARC DNS records).
# Use a verified sender such as the examples below.
#   ⚠️  Do NOT use onboarding@resend.dev (or any *.resend.dev address): that is
#   Resend's SANDBOX domain. Resend ACCEPTS those sends and returns a message id
#   with no error, but ONLY delivers them to the Resend account owner — every
#   real recipient silently receives nothing. Using it is the #1 cause of
#   "emails look sent but nobody gets them".
EMAIL_FROM="Repulabs <notifications@repulabs.com>"

# ---- Stripe ----
# Test keys: https://dashboard.stripe.com/test/apikeys
# Live keys: https://dashboard.stripe.com/apikeys (use sk_live_ in production)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# After running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, paste the whsec_ here
STRIPE_WEBHOOK_SECRET=""
# Pro plan price ID (create in Stripe dashboard, $167/mo, 7-day trial)
STRIPE_PRO_PRICE_ID=""
# Hardware product price IDs (one-time)
STRIPE_HARDWARE_STAND_PRICE_ID=""

# ---- Cron ----
# Long random string. Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}` on each invocation.
# Generate via: openssl rand -base64 32
CRON_SECRET=""

# ---- Anthropic ----
# https://console.anthropic.com — separate keys per env
ANTHROPIC_API_KEY="sk-ant-..."
# Per-tenant default daily AI cap in micros ($1.00 = 1_000_000)
AI_TENANT_DAILY_CAP_MICROS=4000000

# ---- Upstash (Redis + QStash) ----
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ---- Twilio (SMS) ----
# https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+15551234567"

# ---- Encryption ----
# 32-byte key for envelope encryption, base64-encoded
# Generate via: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=""
# 32-byte key for short-link slug HMAC signing
SLUG_HMAC_SECRET=""
# 32-byte secret for OAuth state JWT
OAUTH_STATE_SECRET=""

# ---- Cloudflare ----
# Account-level token with KV write permission for r.<domain> namespace
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_KV_NAMESPACE_ID=""
CLOUDFLARE_API_TOKEN=""

# ---- Observability ----
# Sentry — https://sentry.io
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
# Axiom — https://axiom.co
AXIOM_TOKEN=""
AXIOM_DATASET="repuboost"

# ---- Google Business Profile API ----
# https://console.cloud.google.com — same project as Google SSO; enable GBP API
GBP_CLIENT_ID="${AUTH_GOOGLE_ID}"
GBP_CLIENT_SECRET="${AUTH_GOOGLE_SECRET}"

# ---- Voyage embeddings (chatbot RAG, Phase 1+) ----
VOYAGE_API_KEY=""

# ---- TikTok lead collection automation ----
# Uses compliant public search + public page verification, then appends
# qualified leads into outputs/tiktok-lead-automation/TikTok_Lead_Tracker.xlsx.
# Current implementation uses Brave Search API for discovery.
BRAVE_SEARCH_API_KEY=""
TIKTOK_LEAD_SEARCH_PROVIDER="brave"
TIKTOK_LEAD_TARGET=100
TIKTOK_LEAD_FETCH_TIMEOUT_MS=15000
TIKTOK_LEAD_RESULTS_PER_QUERY=10
TIKTOK_LEAD_DELAY_MS=500
TIKTOK_LEAD_OUTPUT_DIR="outputs/tiktok-lead-automation"
TIKTOK_LEAD_WORKBOOK_PATH="outputs/tiktok-lead-automation/TikTok_Lead_Tracker.xlsx"

# ---- Shopify (hardware storefront) ----
# Public URL surfaced as a "Buy stands" link from /hardware and /hardware/new.
# The Shopify store lives on a separate domain from the SaaS app.
# Falls back to https://repulabs.com.au if unset.
NEXT_PUBLIC_SHOPIFY_STORE_URL="https://repulabs.com.au"

# ---- Vercel Blob (or alternative blob storage for org logos) ----
# Required if you use lib/uploads against Vercel Blob. On AWS, swap for S3 (see docs/AWS_DEPLOY.md).
BLOB_READ_WRITE_TOKEN=""

# ---- ElevenLabs (voice cloning for phone receptionist) ----
# Optional — only needed for AI phone receptionist voice features.
ELEVENLABS_API_KEY=""

# ---- Unsubscribe token HMAC (optional) ----
# If set, used to sign email unsubscribe URLs. If unset, AUTH_SECRET is reused
# (see lib/secrets.ts). Set this when you want to rotate unsubscribe signing
# independently of session cookies.
# Generate via: openssl rand -base64 32
UNSUBSCRIBE_SECRET=""

# =====================================================================
# The vars below are READ BY THE CODE but were previously undocumented.
# =====================================================================

# ---- Hardware activation override (SECURITY-RELEVANT) ----
# The manufacturer mis-printed ONE activation code (84219) across a whole QR
# batch, so we accept it for ANY scanned device — the unique QR slug is what
# actually identifies the unit. Defaults to "84219" so shipped stock works with
# no env change.
#   >> SET THIS TO "" AT THE NEXT PRODUCTION RUN <<
# An empty value restores strict per-device code verification with no code
# change. Leaving it set means anyone holding the printed code + a device slug
# can claim that device. See lib/hardware/actions.ts.
HARDWARE_OVERRIDE_ACTIVATION_CODE="84219"

# ---- OpenAI (AI replies, assistant, drafting) ----
OPENAI_API_KEY=""
# Image generation for social creatives (optional).
IMAGE_GEN_PROVIDER=""
IMAGE_GEN_MODEL=""
# Minimum model confidence before an AI suggestion is surfaced (optional).
AI_ASSIST_CONFIDENCE_THRESHOLD=""

# ---- Webhook signing secrets ----
# Set each to the signing secret from the provider's dashboard. Unset = that
# webhook endpoint cannot verify authenticity, so it should stay disabled.
RESEND_WEBHOOK_SECRET=""
RESEND_INBOUND_WEBHOOK_SECRET=""
GBP_WEBHOOK_SECRET=""
META_WEBHOOK_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""

# ---- Social publishing (optional, per-network) ----
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_TOKEN=""
META_GRAPH_ENABLED="false"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_PUBLISH_ENABLED="false"

# ---- POS / commerce integrations (optional) ----
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""
SQUARE_ENV="sandbox"          # sandbox | production
CLOVER_APP_ID=""
CLOVER_APP_SECRET=""
CLOVER_ENV="sandbox"          # sandbox | production
QUICKBOOKS_ENV="sandbox"      # sandbox | production

# ---- X / Twitter publishing (optional) ----
X_CLIENT_ID=""
X_CLIENT_SECRET=""
TWITTER_PUBLISH_ENABLED="false"

# ---- WhatsApp webhooks (optional) ----
WHATSAPP_WEBHOOK_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ---- Toast POS (optional) ----
TOAST_CLIENT_ID=""
TOAST_CLIENT_SECRET=""
TOAST_API_BASE=""

# ---- Stability AI (image generation, optional) ----
STABILITY_API_KEY=""

# ---- Voice review request delay ----
# Hours to wait after a phone call before sending a review request. Unset uses
# the in-code default.
VOICE_REVIEW_DELAY_HOURS=""

# ---- Google Business Profile dispute checks (optional) ----
GBP_DISPUTE_CHECK_ENABLED="false"

# ---- Onboarding setup video (optional) ----
NEXT_PUBLIC_SETUP_VIDEO_URL=""

# ---- NOTE ON URL VARS ----
# Several overlapping URL vars are read across the codebase:
#   NEXT_PUBLIC_APP_URL     canonical app origin (OAuth callbacks, Stripe returns)
#   AUTH_URL / NEXTAUTH_URL Auth.js origin — must match the host users sign in on
#   NEXT_PUBLIC_MARKETING_URL  public marketing origin (sitemap.xml, robots.txt)
#   APP_URL / NEXT_PUBLIC_BASE_URL  legacy aliases still read in a few places
# Keep them consistent in production. A mismatch here is the usual cause of
# "redirected to localhost" auth bugs — see next.config.mjs for the build-time
# inlining workaround.

# ---- AWS-specific (only set when deploying to AWS) ----
# See docs/AWS_DEPLOY.md for the full architecture.
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET_UPLOADS="repulabs-uploads-prod"
# AWS_RDS_PROXY_ENDPOINT=""
# DATABASE_URL_READONLY=""  # Aurora reader endpoint, optional

# ---- Hostinger VPS / generic VPS deployment ----
# See docs/DEPLOY_HOSTINGER.md for the full deployment runbook.
# Comma-separated CIDR list of IPs allowed to hit /admin/*. Empty = allow any.
# Example: "203.0.113.42,198.51.100.0/24"
ADMIN_IP_ALLOWLIST=""
# Optional: S3-compatible bucket for nightly backup of .env.local + uploads dir.
BACKUP_S3_BUCKET=""
