/// Owner: 12_contacts. Contact timeline (the only table written for it).
/// Idempotent auto-capture via @@unique([contactId, source, externalRef]).
model ContactActivity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  kind           String                                    // captured | tag_added | tag_removed | note_added | imported | merged | manual
  source         String?                                   // google_review | live_chat | survey | social_dm | review_request | shopify
  title          String?
  body           String?
  externalRef    String?  @map("external_ref")
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, source, externalRef])
  @@index([organizationId, contactId, occurredAt(sort: Desc)])
  @@map("contact_activities")
}

