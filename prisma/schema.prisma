// RepuBoost — Prisma schema (Day 1 foundation)
// Multi-tenant via Postgres RLS. RLS policies + WITH CHECK + FORCE applied via raw SQL migration.
// Auth.js Drizzle/Prisma adapter compatible.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, pg_trgm]
}

// ============================================================
// IDENTITY & TENANCY
// ============================================================

model Organization {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String    @unique
  plan            String    @default("trial") // trial | pro | suspended | free
  trialEndsAt     DateTime? @map("trial_ends_at")
  stripeCustomerId String?  @unique @map("stripe_customer_id")
  onboardingStep  Int       @default(0) @map("onboarding_step")
  // Day 11 V3 — enriched profile
  ownerName       String?   @map("owner_name")
  ownerEmail      String?   @map("owner_email")
  phone           String?
  country         String?
  websiteUrl      String?   @map("website_url")
  logoUrl         String?   @map("logo_url")
  businessDescription String? @map("business_description")
  // Free-form workspace settings (e.g. { security: { sessionTimeoutMinutes, twoFactorRequired } }).
  // Merge-on-write so independent setting groups never clobber each other.
  settings        Json?     @map("settings")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Master delta (Wave 0) — SEO onboarding scalars (owner 13_reports).
  seoOnboardingStep          Int       @default(0) @map("seo_onboarding_step")
  seoFirstReportRequestedAt  DateTime? @map("seo_first_report_requested_at")
  seoFirstReportReadyAt      DateTime? @map("seo_first_report_ready_at")

  memberships    Membership[]
  invitations    Invitation[]
  subscription   Subscription?
  webhookEvents  WebhookDelivery[] @relation("OrgWebhooks")
  establishments Establishment[]
  connections    Connection[]
  hardwareOrders HardwareOrder[]
  inboxThreads   InboxThread[]
  reviewRequests ReviewRequest[]
  inboundEmails  InboundEmail[]
  autoReplyRules AutoReplyRule[]

  // Master delta (Wave 0) back-relations.
  // The delta's §C documents a subset as "back-relations only"; Prisma
  // additionally requires an opposite field for EVERY new model that carries
  // an `organization` relation, so all 23 are enumerated here. Pure
  // back-relations are client-only (no SQL).
  knowledgeGaps        KnowledgeGap[]
  scheduledJobs        ScheduledJob[]
  automationRules      AutomationRule[]
  contentLibraryAssets ContentLibraryAsset[]
  socialPostMetrics    SocialPostMetric[]
  moderationItems      ModerationItem[]
  widgetConfigs        WidgetConfig[]
  contactTags          ContactTag[]
  contactCustomFields  ContactCustomField[]
  contactActivities    ContactActivity[]
  surveyInsights       SurveyInsight[]
  surveyAutomations    SurveyAutomation[]
  seoSnapshots         SeoSnapshot[]
  keywordRanks         KeywordRank[]
  competitors          Competitor[]
  citationAudits       CitationAudit[]
  geoGridSnapshots     GeoGridSnapshot[]
  ga4Connections       Ga4Connection[]
  connectionSyncLogs   ConnectionSyncLog[]
  autopilotConfig      AutopilotConfig?
  autopilotActions     AutopilotAction[]
  roiSettings          RoiSettings[]
  autopilotDigestRuns  AutopilotDigestRun[]

  @@index([plan])
  @@index([stripeCustomerId])
  @@map("organizations")
}

model Establishment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  // kind = 'business' (default), 'airbnb_listing', 'booking_listing'.
  // Determines onboarding flow + which CTAs surface in the dashboard.
  // CHECK constraint enforced at the DB level (see migration).
  kind            String    @default("business")
  name            String
  category        String?
  address         Json?
  timezone        String    @default("UTC")
  brandVoice      Json?     @map("brand_voice")
  businessHours   Json?     @map("business_hours")
  googlePlaceId   String?   @map("google_place_id")
  // Day 11 V3 — UI extras
  imageUrl        String?   @map("image_url")
  websiteUrl      String?   @map("website_url")
  phone           String?
  // Day 17 V8 — Short-term rental host extensions (Airbnb / Booking.com)
  airbnbListingId      String? @map("airbnb_listing_id")
  airbnbListingUrl     String? @map("airbnb_listing_url")
  bookingcomListingId  String? @map("bookingcom_listing_id")
  directBookingUrl     String? @map("direct_booking_url")
  houseRules           String? @map("house_rules")
  wifiSsid             String? @map("wifi_ssid")
  // WiFi password is AES-256-GCM encrypted at rest. Plaintext never persisted
  // anywhere except the customer's NFC programmer when they re-write the tag.
  wifiPasswordCt       Bytes?  @map("wifi_password_ct")
  wifiPasswordIv       Bytes?  @map("wifi_password_iv")
  localRecommendations Json?   @default("[]") @map("local_recommendations")
  // Phase 2 follow-on: bad-review SMS early-warning. Opt-in only — both
  // flag and number must be set for alerts to fire.
  alertSmsEnabled    Boolean @default(false) @map("alert_sms_enabled")
  alertSmsPhone      String? @map("alert_sms_phone")              // E.164
  alertSmsMinRating  Int     @default(3) @map("alert_sms_min_rating")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connections  Connection[]
  reviews      Review[]
  devices      Device[]
  hardwareOrderItems HardwareOrderItem[]
  inboxThreads InboxThread[]
  reviewRequests ReviewRequest[]
  reviewRequestTemplates ReviewRequestTemplate[]
  surveyCampaigns SurveyCampaign[] @relation("EstablishmentSurveys")
  platformChoices ReviewPlatformChoice[]
  autoReplyRules  AutoReplyRule[]

  // Master delta (Wave 0) back-relations.
  // NOTE: ga4Connections is modeled one-to-many because Ga4Connection's
  // uniqueness is the composite @@unique([organizationId, establishmentId])
  // (establishmentId alone is nullable, not unique), which Prisma cannot use
  // as a one-to-one defining side. The "one GA4 link per establishment"
  // intent is enforced by that composite unique + the action layer.
  contentLibraryAssets ContentLibraryAsset[]
  automationRules      AutomationRule[]
  seoSnapshots         SeoSnapshot[]
  keywordRanks         KeywordRank[]
  competitors          Competitor[]
  citationAudits       CitationAudit[]
  geoGridSnapshots     GeoGridSnapshot[]
  ga4Connections       Ga4Connection[]

  @@index([organizationId])
  @@index([googlePlaceId])
  @@index([airbnbListingId])
  @@index([bookingcomListingId])
  @@map("establishments")
}

// ============================================================
// DAY 6: OUTREACH (review requests, inbox, consent)
// ============================================================

model SmsConsent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  phoneE164       String   @map("phone_e164")
  consentTextHash String   @map("consent_text_hash")
  consentSource   String   @map("consent_source")
  consentIp       String?  @map("consent_ip") @db.Inet
  consentUa       String?  @map("consent_ua")
  consentedAt     DateTime @map("consented_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([organizationId, phoneE164])
  @@map("sms_consents")
}

model Unsubscribe {
  channel         String   // email | sms
  emailOrPhone    String   @map("email_or_phone")
  organizationId  String   @map("organization_id") @db.Uuid
  unsubscribedAt  DateTime @default(now()) @map("unsubscribed_at")
  source          String?

  @@id([channel, emailOrPhone, organizationId])
  @@index([emailOrPhone, channel, organizationId])
  @@map("unsubscribes")
}

model ReviewRequestTemplate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  establishmentId String?  @map("establishment_id") @db.Uuid
  name            String
  channel         String   // sms | email | both
  subject         String?
  body            String
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  reviewRequests ReviewRequest[]

  @@map("review_request_templates")
}

model ReviewRequest {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  establishmentId   String   @map("establishment_id") @db.Uuid
  templateId        String?  @map("template_id") @db.Uuid
  channel           String
  recipient         String
  recipientName     String?  @map("recipient_name")
  shortSlug         String?  @map("short_slug")
  scheduledFor      DateTime @map("scheduled_for")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  openedAt          DateTime? @map("opened_at")
  clickedAt         DateTime? @map("clicked_at")
  convertedAt       DateTime? @map("converted_at")
  status            String   @default("queued")
  triggerSource     String?  @map("trigger_source")
  error             String?
  providerMessageId String?  @map("provider_message_id")
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  template      ReviewRequestTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, establishmentId, createdAt(sort: Desc)])
  @@index([organizationId, recipient])
  @@map("review_requests")
}

model InboxThread {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  establishmentId       String?  @map("establishment_id") @db.Uuid
  channel               String   // email | facebook_msg | instagram_dm | gbp_qa | webchat | sms
  externalThreadId      String?  @map("external_thread_id")
  subject               String?
  participant           Json?
  status                String   @default("open")
  assigneeId            String?  @map("assignee_id") @db.Uuid
  lastMessageAt         DateTime @default(now()) @map("last_message_at")
  lastMessageBody       String?  @map("last_message_body")
  lastMessageDirection  String?  @map("last_message_direction")
  unreadCount           Int      @default(0) @map("unread_count")
  createdAt             DateTime @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  messages      InboxMessage[]

  @@index([organizationId, status, lastMessageAt(sort: Desc)])
  @@map("inbox_threads")
}

model InboxMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId        String   @map("thread_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  direction       String   // inbound | outbound
  authorUserId    String?  @map("author_user_id") @db.Uuid
  body            String
  attachments     Json?
  aiSuggested     String?  @map("ai_suggested")
  externalId      String?  @map("external_id")
  sentAt          DateTime @default(now()) @map("sent_at")

  thread InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sentAt(sort: Desc)])
  @@map("inbox_messages")
}

// ============================================================
// DAY 7: SURVEYS
// ============================================================

model SurveyCampaign {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  establishmentId     String?  @map("establishment_id") @db.Uuid
  name                String
  type                String   @default("nps")
  channel             String   @default("email")
  triggerEvent        String?  @map("trigger_event")
  delayMinutes        Int      @default(0) @map("delay_minutes")
  incentive           Json?
  status              String   @default("draft")
  smartRouteEnabled   Boolean  @default(true) @map("smart_route_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  establishment Establishment? @relation("EstablishmentSurveys", fields: [establishmentId], references: [id], onDelete: Cascade)
  questions     SurveyQuestion[]
  responses     SurveyResponse[]
  tokens        SurveyResponseToken[]
  // Master delta (Wave 0) back-relation (owner 11_surveys)
  automations   SurveyAutomation[]

  @@index([organizationId, status])
  @@map("survey_campaigns")
}

model SurveyQuestion {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String  @map("campaign_id") @db.Uuid
  position    Int
  type        String
  prompt      String
  options     Json?
  required    Boolean @default(true)

  campaign SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@unique([campaignId, position])
  @@index([campaignId, position])
  @@map("survey_questions")
}

model SurveyResponseToken {
  tokenHash       String    @id @map("token_hash")
  campaignId      String    @map("campaign_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  recipient       String
  recipientName   String?   @map("recipient_name")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  campaign SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([expiresAt])
  @@map("survey_response_tokens")
}

model SurveyResponse {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId      String    @map("campaign_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  recipient       String?
  ratingSummary   Decimal?  @map("rating_summary") @db.Decimal(3, 2)
  smartRouteTo    String?   @map("smart_route_to")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  campaign SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@index([campaignId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("survey_responses")
}

model SurveyAnswer {
  responseId String @map("response_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  value      Json

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id])

  @@id([responseId, questionId])
  @@map("survey_answers")
}

// ============================================================
// DAY 8: AI CHATBOT — RAG + Widget
// ============================================================

model AiDocument {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  establishmentId String?   @map("establishment_id") @db.Uuid
  title           String
  sourceType      String    @map("source_type")           // manual | url | pdf | gbp_listing
  sourceUri       String?   @map("source_uri")
  sourceMetadata  Json?     @map("source_metadata")       // {fetched_at, http_status, content_type, robots_disallowed}
  content         String
  contentHash     String    @map("content_hash")
  status          String    @default("indexing")
  lastIndexedAt   DateTime? @map("last_indexed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  embeddings AiEmbedding[]

  @@index([organizationId, status])
  @@map("ai_documents")
}

// NOTE: `embedding` column is a pgvector `vector(1024)` type. Prisma has no native vector type,
// so we model the column with @ignore for the vector and access it via raw SQL only.
// The rest of the fields are queryable through Prisma.
model AiEmbedding {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  establishmentId String?  @map("establishment_id") @db.Uuid
  chunkText       String   @map("chunk_text")
  // embedding     Unsupported("vector(1024)")  — accessed via raw SQL only
  contentHash     String   @map("content_hash")
  position        Int
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  document AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, establishmentId])
  @@index([documentId, position])
  @@map("ai_embeddings")
}

model AiConversation {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  establishmentId        String?   @map("establishment_id") @db.Uuid
  visitorId              String    @map("visitor_id")
  channel                String    @default("webchat")
  leadEmail              String?   @map("lead_email")
  leadPhone              String?   @map("lead_phone")
  handedOffAt            DateTime? @map("handed_off_at")
  consentRecordedAt      DateTime? @map("consent_recorded_at")
  parentConversationId   String?   @map("parent_conversation_id") @db.Uuid
  terminatedReason       String?   @map("terminated_reason")
  createdAt              DateTime  @default(now()) @map("created_at")

  parent   AiConversation?  @relation("ConversationFork", fields: [parentConversationId], references: [id])
  children AiConversation[] @relation("ConversationFork")

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([visitorId, createdAt(sort: Desc)])
  @@map("ai_conversations")
}

model WidgetKey {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  establishmentId        String?  @map("establishment_id") @db.Uuid
  publicKey              String   @unique @map("public_key")
  hmacSecret             String   @map("hmac_secret")
  originAllowlist        String[] @map("origin_allowlist")
  rateLimitWindowSec     Int      @default(300) @map("rate_limit_window_sec")
  rateLimitMaxMsgs       Int      @default(20) @map("rate_limit_max_msgs")
  status                 String   @default("active")
  // Master delta (Wave 0, owner 09_inbox): widget AI behaviour mode. Default
  // preserves current always-on behaviour.
  aiMode                 String   @default("always_on") @map("ai_mode")  // always_on | after_hours | ai_human_handoff
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("widget_keys")
}

// ============================================================
// HARDWARE (Day 4)
// ============================================================

model HardwareProduct {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku             String  @unique
  name            String
  description     String?
  priceCents      Int     @map("price_cents")
  currency        String  @default("USD")
  hasNfc          Boolean @default(false) @map("has_nfc")
  unitsPerPack    Int     @default(1) @map("units_per_pack")
  imageUrl        String? @map("image_url")
  stripePriceId   String? @map("stripe_price_id")
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  orderItems HardwareOrderItem[]

  @@map("hardware_products")
}

model HardwareOrder {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  status                   String   @default("pending")
  shippingAddress          Json     @map("shipping_address")
  totalCents               Int      @map("total_cents")
  currency                 String   @default("USD")
  stripeSessionId          String?  @unique @map("stripe_session_id")
  stripePaymentIntentId    String?  @unique @map("stripe_payment_intent_id")
  carrier                  String?
  trackingNumber           String?  @map("tracking_number")
  shippedAt                DateTime? @map("shipped_at")
  deliveredAt              DateTime? @map("delivered_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        HardwareOrderItem[]
  devices      Device[]

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("hardware_orders")
}

model HardwareOrderItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  establishmentId  String? @map("establishment_id") @db.Uuid
  quantity         Int
  unitPriceCents   Int     @map("unit_price_cents")

  order         HardwareOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       HardwareProduct  @relation(fields: [productId], references: [id])
  establishment Establishment?   @relation(fields: [establishmentId], references: [id])

  @@index([orderId])
  @@map("hardware_order_items")
}

model Device {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String?   @map("organization_id") @db.Uuid
  establishmentId        String?   @map("establishment_id") @db.Uuid
  orderId                String?   @map("order_id") @db.Uuid
  productSku             String    @map("product_sku")
  // Physical product kind. 'qr' = printed QR plaque, 'nfc' = NFC tag,
  // 'wifi' = WiFi-credentials NFC card, 'multi_platform' = picker QR that
  // shows guest a "where do you want to review?" page.
  productKind            String    @default("qr") @map("product_kind")
  serial                 String    @unique
  shortSlug              String    @unique @map("short_slug")
  slugSignature          String    @map("slug_signature")
  nfcUid                 String?   @unique @map("nfc_uid")
  activationCodeHash     String    @map("activation_code_hash")
  activationCodeUsedAt   DateTime? @map("activation_code_used_at")
  redirectUrl            String?   @map("redirect_url")
  redirectMode           String    @default("direct") @map("redirect_mode")
  redirectChangedAt      DateTime? @map("redirect_changed_at")
  status                 String    @default("unactivated")
  scanCount              Int       @default(0) @map("scan_count")
  lastScanAt             DateTime? @map("last_scan_at")
  activatedAt            DateTime? @map("activated_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  establishment Establishment? @relation(fields: [establishmentId], references: [id])
  order         HardwareOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  scans         DeviceScan[]
  platformChoices ReviewPlatformChoice[]

  @@index([shortSlug])
  @@map("devices")
}

model DeviceScan {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId        String   @map("device_id") @db.Uuid
  organizationId  String?  @map("organization_id") @db.Uuid
  scanId          String   @map("scan_id")
  scannedAt       DateTime @default(now()) @map("scanned_at")
  userAgent       String?  @map("user_agent")
  ip              String?  @db.Inet
  country         String?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, scanId])
  @@index([deviceId, scannedAt(sort: Desc)])
  @@map("device_scans")
}

model Review {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  establishmentId        String    @map("establishment_id") @db.Uuid
  source                 String    // google | facebook | yelp | trustpilot | internal | mock
  externalId             String    @map("external_id")
  reviewerName           String?   @map("reviewer_name")
  rating                 Int
  body                   String?
  language               String?
  postedAt               DateTime  @map("posted_at")
  attributedDeviceId     String?   @map("attributed_device_id") @db.Uuid
  attributedRequestId    String?   @map("attributed_request_id") @db.Uuid
  sentiment              Decimal?  @db.Decimal(3, 2)
  topics                 String[]
  topicsExtractedAt      DateTime? @map("topics_extracted_at")
  sentimentExtractedAt   DateTime? @map("sentiment_extracted_at")
  raw                    Json?
  fetchedAt              DateTime  @default(now()) @map("fetched_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  reply         ReviewReply?

  @@unique([establishmentId, source, externalId])
