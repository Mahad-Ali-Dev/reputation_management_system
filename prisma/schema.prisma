// ============================================================
// PHASE 2 — AIRBNB / SHORT-TERM RENTAL REVIEW MANAGEMENT
// ============================================================

/// Raw inbound emails forwarded by hosts from their Airbnb (and later
/// Booking.com) notification stream. Parse-once-store-raw pattern: we keep
/// the original HTML/text so that if our parser breaks (Airbnb changes
/// their template), we can re-parse historical emails without asking the
/// host to re-forward anything.
///
/// Routing model: the host sets up a Gmail/forward rule from
/// `automated@airbnb.com` to `reviews-<org-slug>@inbound.repulabs.com`. The
/// Resend inbound webhook hits our endpoint, which:
///   1. Reads the local-part of the To address, resolves it to an org
///   2. Inserts a row with parsed_at = NULL
///   3. Runs the parser; on success, links parsed_review_id; on failure,
///      stores the error message in parse_error and leaves the row for the
///      retry-sweep cron to try later (after we ship a parser fix).
///
/// `provider_message_id` is Resend's message UUID — unique per inbound
/// delivery, used to dedupe at-least-once webhook retries.
model InboundEmail {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String?   @map("organization_id") @db.Uuid
  source            String    @default("airbnb")
  toAddress         String    @map("to_address")
  fromAddress       String    @map("from_address")
  subject           String?
  htmlBody          String?   @map("html_body")
  textBody          String?   @map("text_body")
  parsedAt          DateTime? @map("parsed_at")
  parsedReviewId    String?   @map("parsed_review_id") @db.Uuid
  parseError        String?   @map("parse_error")
  providerMessageId String?   @unique @map("provider_message_id")
  receivedAt        DateTime  @default(now()) @map("received_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, receivedAt(sort: Desc)])
  @@index([parsedAt])
  @@map("inbound_emails")
}

/// Which review platform a guest tapped on the multi-platform picker QR.
/// Powers attribution: "47 of 89 Airbnb reviews this month came from QR
/// taps via this stand." Also stores opt-in email for the day-after-checkout
/// reminder cron (only if the guest provided it; never required).
model ReviewPlatformChoice {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  deviceId        String   @map("device_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  /// 'google' | 'airbnb' | 'tripadvisor' | 'booking_com' | 'direct'
  /// `direct` = guest tapped "Book us directly next time" → host's URL.
  platform        String
  guestEmail      String?  @map("guest_email")
  reservationHint String?  @map("reservation_hint")
  ip              String?  @db.Inet
  userAgent       String?  @map("user_agent")
  chosenAt        DateTime @default(now()) @map("chosen_at")
  /// Idempotency marker for the day-after-checkout reminder cron. Non-null
  /// = we already emailed this guest; cron skips. Null + chosen_at in
  /// the 22–26h window = eligible for send.
  reminderSentAt  DateTime? @map("reminder_sent_at")

  device        Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, chosenAt(sort: Desc)])
  @@index([organizationId, chosenAt(sort: Desc)])
  @@map("review_platform_choices")
}

/// Per-listing automation rule for AI replies.
///
/// Evaluation model: when a Review is ingested, rules for that
/// organization are iterated in `createdAt` order. The FIRST rule whose
/// match criteria all match the review fires. Match criteria are AND'd —
/// a rule with min_rating=5, max_rating=5, sources=['airbnb','google']
/// fires only on 5-star reviews from those two platforms.
///
/// `action`:
///   - 'draft_only'              — AI generates a reply draft in `pending_review`
///     status. Host approves manually.
///   - 'auto_publish_after_delay' — Same draft + auto-publish after
///     `delay_minutes` minutes. Soft buffer = host can intercept a
///     mis-publish via the dashboard's pending list.
model AutoReplyRule {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  /// NULL = org-wide rule. Per-establishment rules let mixed Airbnb/Google
  /// hosts tune behavior independently per listing.
  establishmentId  String?  @map("establishment_id") @db.Uuid
  name             String
  enabled          Boolean  @default(true)
  // Match criteria (all AND'd at evaluation time).
  matchMinRating   Int      @default(5) @map("match_min_rating")
  matchMaxRating   Int      @default(5) @map("match_max_rating")
  matchKeywords    String[] @default([]) @map("match_keywords")  // case-insensitive substring; ≥1 must match if non-empty
  matchSources     String[] @default([]) @map("match_sources")    // empty = all sources
  // Action.
  action           String   @default("draft_only")
  delayMinutes     Int      @default(5) @map("delay_minutes")
  replyTone        String   @default("warm") @map("reply_tone")
  // Audit.
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  fireCount        Int      @default(0) @map("fire_count")
  lastFiredAt      DateTime? @map("last_fired_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled])
  @@index([establishmentId])
  @@map("auto_reply_rules")
}

