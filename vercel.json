{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync-reviews",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/extract-topics",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/dispatch-outbound",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/picker-reminder",
      "schedule": "3 * * * *"
    },
    {
      "path": "/api/cron/auto-reply-publish",
      "schedule": "*/5 * * * *"
    }
  ]
}
