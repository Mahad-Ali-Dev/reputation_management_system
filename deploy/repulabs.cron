# repulabs — VPS cron schedule. GENERATED FROM vercel.json (which does nothing
# off Vercel). Regenerate: python3 scripts/gen-cron.py
#
# Install as the deploy user:   crontab /opt/repulabs/deploy/repulabs.cron
# Verify (expect 21):           crontab -l | grep -cE '^[*0-9]'   (counts schedule lines only)
# Each line calls the wrapper, which reads CRON_SECRET from .env.production and
# hits the endpoint with the Bearer header. No secret lives in this file.
SHELL=/bin/bash


# Reviews: HOURLY, not */15. Each sync paginates the listing via HasData and
# every page costs credits. Incremental sync makes a steady-state run ~1 page,
# but 96 runs/day still buys little on data that changes a few times a week.
0 * * * * /bin/bash /opt/repulabs/deploy/cron-hit.sh sync-reviews
*/30 * * * * /bin/bash /opt/repulabs/deploy/cron-hit.sh extract-topics
0 13 * * *   /bin/bash /opt/repulabs/deploy/cron-hit.sh daily-digest
* * * * *    /bin/bash /opt/repulabs/deploy/cron-hit.sh dispatch-outbound
3 * * * *    /bin/bash /opt/repulabs/deploy/cron-hit.sh picker-reminder
*/5 * * * *  /bin/bash /opt/repulabs/deploy/cron-hit.sh auto-reply-publish
* * * * *    /bin/bash /opt/repulabs/deploy/cron-hit.sh dispatch-scheduled
0 12 * * *   /bin/bash /opt/repulabs/deploy/cron-hit.sh daily-briefing
0 6 * * 1    /bin/bash /opt/repulabs/deploy/cron-hit.sh ai-kb-refresh
* * * * *    /bin/bash /opt/repulabs/deploy/cron-hit.sh dispatch-review-requests
0 14 * * *   /bin/bash /opt/repulabs/deploy/cron-hit.sh dispute-status
0 4 * * 0    /bin/bash /opt/repulabs/deploy/cron-hit.sh refresh-survey-insights
*/15 * * * * /bin/bash /opt/repulabs/deploy/cron-hit.sh sync-connections
*/5 * * * *  /bin/bash /opt/repulabs/deploy/cron-hit.sh gmail-sync
*/30 * * * * /bin/bash /opt/repulabs/deploy/cron-hit.sh contacts-rollup
*/15 * * * * /bin/bash /opt/repulabs/deploy/cron-hit.sh moderation-rescan
*/5 * * * *  /bin/bash /opt/repulabs/deploy/cron-hit.sh livechat-stale-sweep
* * * * *    /bin/bash /opt/repulabs/deploy/cron-hit.sh dispatch-social-posts
0 7 * * *    /bin/bash /opt/repulabs/deploy/cron-hit.sh refresh-social-metrics
0 6 * * 1    /bin/bash /opt/repulabs/deploy/cron-hit.sh seo-refresh
0 14 * * 1   /bin/bash /opt/repulabs/deploy/cron-hit.sh autopilot-weekly
