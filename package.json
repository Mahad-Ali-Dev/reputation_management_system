{
  "name": "repuboost",
  "version": "0.1.0",
  "private": true,
  "description": "RepuBoost — multi-tenant reputation management SaaS",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run tests/rls",
    "test:crypto": "vitest run tests/crypto",
    "test:outreach": "vitest run tests/outreach",
    "test:ai": "vitest run tests/ai",
    "test:surveys": "vitest run tests/surveys",
    "test:flags": "vitest run tests/flags",
    "test:evals": "RUN_LIVE_AI_EVALS=1 vitest run tests/evals",
    "test:mock-review": "tsx scripts/test-mock-review.ts",
    "test:mock-review:clean": "tsx scripts/cleanup-mock-reviews.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "audit:verify": "tsx scripts/verify-audit-chain.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "preflight": "pnpm typecheck && pnpm lint && pnpm test",
    "build:prod": "NODE_ENV=production prisma migrate deploy && prisma generate && next build",
    "start:prod": "NODE_ENV=production next start -p ${PORT:-3000}",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry-run": "bash scripts/deploy.sh --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.1.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.4",
    "@sentry/nextjs": "^10.53.1",
    "@types/qrcode": "^1.5.6",
    "@upstash/qstash": "^2.7.21",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.34.3",
    "@vercel/blob": "^2.3.3",
    "archiver": "^8.0.0",
    "argon2": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "next": "15.1.0",
    "next-auth": "5.0.0-beta.25",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.0.1",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
