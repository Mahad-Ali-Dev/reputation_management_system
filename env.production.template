# ==============================================================================
# Repulabs — PRODUCTION .env
#
# Copy to /opt/repulabs/.env.production on the VPS and fill the blanks.
# Values already filled in are the correct production values — leave them.
#
#   SaaS app       https://repulabs.com        (marketing = apex)
#   App subdomain  https://app.repulabs.com
#   Admin          https://admin.repulabs.com
#   Redirects      https://r.repulabs.com
#   Hardware shop  https://repulabs.com.au     (separate Shopify store)
#
# Sections are ordered: [1] must fill  [2] should fill  [3] optional.
# NEVER commit the filled version.
# ==============================================================================


# ==============================================================================
# [1] REQUIRED — the app will not run correctly without these
# ==============================================================================

# ---- Core ----
NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1
LOG_LEVEL=info

NEXT_PUBLIC_APP_URL=https://repulabs.com
NEXT_PUBLIC_MARKETING_URL=https://repulabs.com
APP_DOMAIN=repulabs.com
ADMIN_DOMAIN=admin.repulabs.com
REDIRECT_DOMAIN=r.repulabs.com

# ---- Database (Neon) ----
# Pooled connection string (app runtime)
DATABASE_URL=""
# Direct / non-pooled — migrations only (use the NON-pooler hostname)
DIRECT_URL=""

# ---- Auth.js ----
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL=https://repulabs.com
# MUST be true behind nginx, or login redirects break in production.
AUTH_TRUST_HOST=true

# Google SSO + Business Profile connect (same OAuth client)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
GBP_CLIENT_ID="${AUTH_GOOGLE_ID}"
GBP_CLIENT_SECRET="${AUTH_GOOGLE_SECRET}"

# ---- Email (Resend) ----
RESEND_API_KEY=""
# MUST be on a domain verified in Resend. Never use *.resend.dev — Resend
# accepts those silently and only delivers to the account owner.
EMAIL_FROM="Repulabs <notifications@repulabs.com>"

# ---- Stripe ----
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring MONTHLY price of A$79.00 in **AUD**. The 7-day trial is applied by
# our checkout code (TRIAL_DAYS in lib/billing/plans.ts) — do NOT also put a
# trial on the Stripe price or it double-counts.
STRIPE_PRO_PRICE_ID=""
STRIPE_HARDWARE_STAND_PRICE_ID=""

# ---- Encryption (all three: openssl rand -base64 32) ----
# Rotating these invalidates stored OAuth tokens — customers must reconnect.
ENCRYPTION_MASTER_KEY=""
SLUG_HMAC_SECRET=""
OAUTH_STATE_SECRET=""

# ---- Cron auth ----
CRON_SECRET=""

# ---- AI ----
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_TENANT_DAILY_CAP_MICROS=4000000


# ==============================================================================
# [2] SECURITY / LAUNCH DECISIONS — read the comments before setting
# ==============================================================================

# ---- Hardware activation override  (SECURITY-RELEVANT) ----
# The manufacturer mis-printed ONE code (84219) across an entire QR batch, so we
# accept it for ANY scanned device — the unique QR slug identifies the unit.
# Leaving it set means: printed code + a device slug = anyone can claim that
# device.  >> SET TO "" AT THE NEXT PRODUCTION RUN <<  (restores strict
# per-device verification with no code change). See lib/hardware/actions.ts.
HARDWARE_OVERRIDE_ACTIVATION_CODE="84219"

# ---- Gmail OAuth isolation ----
# Google verifies per OAuth client and the tier follows the most privileged
# scope. gmail.readonly/.send are RESTRICTED -> a paid CASA security assessment
# for the WHOLE app. Put Gmail on its own Cloud project and the main client
# stays on the SENSITIVE track (verification only).
# Unset = falls back to AUTH_GOOGLE_ID/SECRET.
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""

# ---- Search Console ----
# Only needed for HTML-tag verification. Blank if verifying by DNS TXT.
GOOGLE_SITE_VERIFICATION=""


